# Copy to .env.monitoring and fill in. Never commit the filled file.

# Docker network of the app to monitor (created by the app's own
# docker-compose.yml). One monitoring stack per environment:
#   __SLUG__-prod-network on the prod server, __SLUG__-staging-network on staging.
APP_NETWORK=__SLUG__-prod-network

# Grafana initial admin password.
GRAFANA_ADMIN_PASSWORD=change-me

# Alertmanager SMTP. Office 365 / Exchange Online: smtp.office365.com:587.
# Gmail / Google Workspace: smtp.gmail.com:587 with an app password.
ALERT_SMTP_HOST=smtp.office365.com:587
ALERT_SMTP_FROM=alerts@example.com
ALERT_SMTP_USERNAME=alerts@example.com
ALERT_SMTP_PASSWORD=

# Alert recipients (comma-separated).
ALERT_RECIPIENTS=
